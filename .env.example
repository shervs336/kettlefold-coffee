# Copy to .env.local and fill in.

# Supabase (same project as the other demos is fine) → Project Settings → API Keys
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=

# Stripe TEST keys only (Developers → API keys, with "Test mode" on). Live keys are refused.
STRIPE_SECRET_KEY=sk_test_...
# Webhook signing secret (Developers → Webhooks → your endpoint). Optional locally.
STRIPE_WEBHOOK_SECRET=

# Order confirmation emails (Resend free tier). Optional.
RESEND_API_KEY=
RESEND_FROM="Kettlefold Coffee <onboarding@resend.dev>"

# Taste search embeddings (Google AI Studio free tier). Optional.
GOOGLE_GENERATIVE_AI_API_KEY=

# Comma-separated emails allowed into /admin
ADMIN_EMAILS=
